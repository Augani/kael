use kael_ui::prelude::*;

fn main() {
    Application::new().run(|cx| {
        kael_ui::init(cx);
        install_theme(cx, Theme::tokyo_night());

        cx.open_window(
            WindowOptions {
                titlebar: Some(TitlebarOptions {
                    title: Some("{{name}}".into()),
                    ..Default::default()
                }),
                ..Default::default()
            },
            |_, cx| cx.new(|_| HelloView),
        )
        .unwrap();
        cx.activate(true);
    });
}

struct HelloView;

impl Render for HelloView {
    fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
        div()
            .size_full()
            .flex()
            .flex_col()
            .items_center()
            .justify_center()
            .gap(px(16.0))
            .child(div().text_size(px(28.0)).child("Hello, Kael!"))
            .child(Button::new("get-started", "Get started"))
    }
}
