  "artifact_configuration_differences": {
    "both": [
      "Standalone workspace manifests resolve Kael workspace metadata explicitly.",
      "platform/mod.rs selects the existing Linux module on Mac and disables the native Mac module; no native Mac notification service is used.",
      "Extra private fake-service test module appended after the exact production Linux source in artifact5.",
      "Copied local.rs test mock uses an equivalent let-chain for standalone strict Clippy; production local.rs unchanged.",
      "Private bus runner sets isolated session and system bus addresses, times out child at 120 seconds and always terminates its daemon."
    ],
    "zbus5": [
      "Pins zbus5.18.0 with original async-io/blocking-api features.",
      "Final lock seeded from root, pruned offline; subsequent builds/checks locked+offline.",
      "Fake async server uses Zbus5 fallible builder API; actual client dispatch is unchanged blocking production code."
    ],
    "zbus6": [
      "Pins unshipped zbus6.0.0 default-rt+proxy; service feature used only by fixture.",
      "Uses async Connection/Proxy/SignalStream and built-in Variant instead of removed blocking APIs/zvariant aliases.",
      "Sync public delivery uses zbus::block_on and retains original listener-thread topology.",
      "Feasibility uses its own standalone dependency graph; it does not establish whole-workspace Zbus6 migration readiness."
    ]
  },
  "protocol_cases": [
    "Exact Unicode summary/body/subtitle and app-name/replaces-ID/icon/timeout tuple.",
    "Named sound string, suppress-sound true, default empty sound hints.",
    "Default plus localized custom action pairs and all three colliding public IDs.",
    "Unrelated ID, close ID, member and unknown exact/leading-zero key filtering.",
    "One known action dispatch, then callback capture release; matching closure without action also releases.",
    "Service failure, Notify reply with String instead of uint32, and malformed ActionInvoked/NotificationClosed bodies reject explicitly."
  ],
