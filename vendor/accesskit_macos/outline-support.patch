+    }
+    let visible: NSRange = unsafe { msg_send![&*input, accessibilityVisibleCharacterRange] };
+    assert_eq!(
+        (visible.location, visible.length),
+        (0, 7),
+        "mounted glyphs and zero-advance line endings retain their real visible positions"
