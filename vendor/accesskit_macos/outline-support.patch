+#[cfg(test)]
+mod outline_tests {
+    use super::*;
+    use accesskit::{Node as NodeData, NodeId as LocalId, Tree as TreeData, TreeId, TreeUpdate};
+
+    fn tree(nodes: Vec<(LocalId, NodeData)>) -> Tree {
+        Tree::new(
+            TreeUpdate {
+                nodes,
+                tree: Some(TreeData::new(LocalId(0))),
+                tree_id: TreeId::ROOT,
+                focus: LocalId(0),
+            },
+            true,
+        )
+    }
+
+    fn row(level: usize, expanded: Option<bool>, children: &[u64]) -> NodeData {
+        let mut node = NodeData::new(Role::TreeItem);
+        node.set_level(level);
+        node.set_children(children.iter().map(|id| LocalId(*id)).collect::<Vec<_>>());
+        if let Some(expanded) = expanded {
+            node.set_expanded(expanded);
+        }
+        node
+    }
+
+    #[test]
+    fn outlines_enumerate_descendants_in_preorder_and_prune_closed_and_hidden_rows() {
+        let mut root = NodeData::new(Role::Tree);
+        root.set_children(vec![LocalId(1), LocalId(5)]);
+        let mut group = NodeData::new(Role::GenericContainer);
+        group.set_children(vec![LocalId(3), LocalId(4)]);
+        let mut hidden = row(3, None, &[]);
+        hidden.set_hidden();
+        let tree = tree(vec![
+            (LocalId(0), root),
+            (LocalId(1), row(1, Some(true), &[2])),
+            (LocalId(2), group),
+            (LocalId(3), row(2, None, &[])),
+            (LocalId(4), hidden),
+            (LocalId(5), row(1, Some(false), &[6])),
+            (LocalId(6), row(2, None, &[])),
+        ]);
+        let state = tree.state();
+        let root = state
+            .node_by_tree_local_id(LocalId(0), TreeId::ROOT)
+            .unwrap();
+        let actual = container_rows(&root)
+            .map(|node| node.id())
+            .collect::<Vec<_>>();
+        let expected = [1, 3, 5].map(|id| {
+            state
+                .node_by_tree_local_id(LocalId(id), TreeId::ROOT)
+                .unwrap()
+                .id()
+        });
+        assert_eq!(actual, expected);
+        assert_eq!(
+            root.items(filter).count(),
+            2,
+            "generic items stop at top-level rows"
+        );
+    }
+
+    #[test]
+    fn disclosure_level_and_actions_preserve_state_capabilities_and_disabled_rows() {
+        let mut root = NodeData::new(Role::Tree);
+        root.set_children(vec![LocalId(1), LocalId(3)]);
+        let mut expanded = row(1, Some(true), &[2]);
+        expanded.add_action(Action::Collapse);
+        expanded.add_action(Action::Expand);
+        let mut disabled = row(1, Some(false), &[]);
+        disabled.set_disabled();
+        disabled.add_action(Action::Expand);
+        let mut child = row(2, None, &[]);
+        child.clear_level(); // Fall back to semantic ancestors when level is omitted.
+        let tree = tree(vec![
+            (LocalId(0), root),
+            (LocalId(1), expanded),
+            (LocalId(2), child),
+            (LocalId(3), disabled),
+        ]);
+        let state = tree.state();
+        let parent = state
+            .node_by_tree_local_id(LocalId(1), TreeId::ROOT)
+            .unwrap();
+        let child = state
+            .node_by_tree_local_id(LocalId(2), TreeId::ROOT)
+            .unwrap();
+        let disabled = state
+            .node_by_tree_local_id(LocalId(3), TreeId::ROOT)
+            .unwrap();
+        assert_eq!(disclosure_level(&parent), 0);
+        assert_eq!(disclosure_level(&child), 1);
+        assert_eq!(disclosure_action(&parent, true), None);
+        assert_eq!(disclosure_action(&parent, false), Some(Action::Collapse));
+        assert_eq!(disclosure_action(&child, true), None);
+        assert_eq!(disclosure_action(&disabled, true), None);
+    }
+
+    #[test]
+    fn hundred_thousand_rows_are_all_available_without_visual_bounds() {
+        let mut root = NodeData::new(Role::Tree);
+        root.set_children(vec![LocalId(1)]);
+        let mut parent = row(1, Some(true), &[]);
+        parent.set_children((2..100_002).map(LocalId).collect::<Vec<_>>());
+        let mut nodes = vec![(LocalId(0), root), (LocalId(1), parent)];
+        nodes.extend((2..100_002).map(|id| (LocalId(id), row(2, None, &[]))));
+        let tree = tree(nodes);
+        let state = tree.state();
+        let root = state
+            .node_by_tree_local_id(LocalId(0), TreeId::ROOT)
+            .unwrap();
+        let rows = container_rows(&root).collect::<Vec<_>>();
+        assert_eq!(rows.len(), 100_001);
+        assert!(!rows.last().unwrap().has_bounds());
+        assert_eq!(
+            rows.last().unwrap().id(),
+            state
+                .node_by_tree_local_id(LocalId(100_001), TreeId::ROOT)
+                .unwrap()
+                .id()
+        );
+    }
+}
