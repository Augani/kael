 use crate::{context::Context, filters::filter, util::*};
 
 const SCROLL_TO_VISIBLE_ACTION: &str = "AXScrollToVisible";
+const EXPAND_ACTION: &str = "AXExpand";
+const COLLAPSE_ACTION: &str = "AXCollapse";
+
+// NSAccessibility outlines enumerate every disclosed row in preorder. The
+// generic consumer `items` iterator stops at an item and therefore only exposes
+// the top-level rows of a hierarchical tree.
+struct ContainerRows<'a> {
+    pending: Vec<Node<'a>>,
+    outline: bool,
+}
+
+fn container_rows<'a>(node: &Node<'a>) -> ContainerRows<'a> {
+    ContainerRows {
+        pending: node.filtered_children(filter).rev().collect(),
+        outline: node.role() == Role::Tree,
+    }
+}
+
+impl<'a> Iterator for ContainerRows<'a> {
+    type Item = Node<'a>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        while let Some(row) = self.pending.pop() {
+            let is_row = if self.outline {
+                row.role() == Role::TreeItem
+            } else {
+                row.is_item_like()
+            };
+            if !is_row || (self.outline && row.data().is_expanded() != Some(false)) {
+                self.pending.extend(row.filtered_children(filter).rev());
+            }
+            if is_row {
+                return Some(row);
+            }
+        }
+        None
+    }
+}
+
+fn disclosure_action(node: &Node, disclosed: bool) -> Option<Action> {
+    if !can_act(node) || node.data().is_expanded() == Some(disclosed) {
+        return None;
+    }
+    let action = if disclosed {
+        Action::Expand
+    } else {
+        Action::Collapse
+    };
+    node.supports_action(action, &filter).then_some(action)
+}
+
+fn disclosure_level(node: &Node) -> NSInteger {
+    node.level().map_or_else(
+        || {
+            let mut level = 0;
+            let mut parent = node.parent();
+            while let Some(row) = parent {
+                if row.role() == Role::TreeItem {
+                    level += 1;
+                }
+                parent = row.parent();
+            }
+            level
+        },
+        |level| level.saturating_sub(1).min(NSInteger::MAX as usize) as NSInteger,
+    )
+}
 
 fn ns_role(node: &Node) -> &'static NSAccessibilityRole {
     let role = node.role();
