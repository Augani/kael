+        let store = resolve_image_assets(&animation, None, limits).unwrap();
+        assert!(store.get(&animation, "first").is_err());
+        assert_eq!(store.decoded_bytes.get(), 0);
+        assert!(store.get(&animation, "second").unwrap().is_some());
