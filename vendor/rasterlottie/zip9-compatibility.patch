+            "assets":[{"id":"image","w":1,"h":256,"p":"pixel.png"},
+                      {"id":"unused","w":1,"h":1,"e":1,"p":"not-valid-base64"}],
+            "layers":[{"ty":2,"ind":1,"refId":"image"}]}"#;
+        let bytes = archive(
+            &[
+                ("manifest.json", br#"{"animations":[{"id":"main"}]}"#),
