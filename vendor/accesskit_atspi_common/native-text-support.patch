+/// Opt-in atomic native text edits. Returning true means the request was
+/// accepted; the host must still validate its origin before deferred execution.
+pub trait TextEditHandler {
+    fn edit_text(&mut self, request: TextEditRequest) -> bool;
+}
+
+pub struct TextEditHandlerWrapper<H: ActionHandler + TextEditHandler + Send>(Mutex<H>);
+
+impl<H: ActionHandler + TextEditHandler + Send> TextEditHandlerWrapper<H> {
+    pub fn new(inner: H) -> Self {
+        Self(Mutex::new(inner))
+    }
